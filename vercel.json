{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{server/**,node_modules/pdfjs-dist/standard_fonts/**,node_modules/tesseract.js/src/**,node_modules/tesseract.js-core/*lstm*,node_modules/tesseract.js-core/index.js,node_modules/tesseract.js-core/package.json,node_modules/@napi-rs/**}"
    },
    "api/finance-sin1.js": {
      "maxDuration": 30,
      "regions": [
        "sin1"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!finance-sin1$).*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/assets/scenes/:file",
      "destination": "/api/index.js"
    },
    {
      "source": "/js/scenes/:file",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/run-tasks",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/refresh-models",
      "schedule": "0 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.e2b.app https://*.vercel.run; font-src 'self'; frame-src 'self' https://www.youtube-nocookie.com; connect-src 'self' https://*.e2b.app wss://*.e2b.app wss://*.vercel.run; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
