{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/run-tasks",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/refresh-models",
      "schedule": "0 23 * * *"
    }
  ]
}
