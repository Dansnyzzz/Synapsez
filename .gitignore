node_modules/
data/
.env
# Local MCP server config — may hold tokens or a database URL.
# .mcp.json.example is the committed, valueless version.
.mcp.json
.claude/settings.local.json
.env.local
.env*.local
# Google Cloud's OAuth client download (client_secret_<id>.apps.googleusercontent.com.json).
# Its values belong in .env as GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET; the
# file itself must never be committed — one sat untracked in the root (2026-10-14).
client_secret*.json
.vercel
.DS_Store
*.log

# Orphans left by a FUSE mount when a file is deleted while something still has
# it open — stale copies of files that already exist properly. Two of these were
# committed once by a `git add -A`; ignoring the pattern is what stops that
# being possible again.
.fuse_hidden*

# The evidence ledger and run journal — local, per-checkout state.
# A green stamp must mean the gate ran *here*, so it is never shared.
.claude/state/

# Coverage output — a report, regenerated by `npm run coverage`.
coverage/
.nyc_output/
